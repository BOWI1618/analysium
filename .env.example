# Copy to apps/api/.env and fill in real values.

# PostgreSQL. `npm run db:up` starts one on this port via docker compose.
DATABASE_URL="postgresql://flowdesk:flowdesk@localhost:5433/flowdesk?schema=public"

PORT=4000
NODE_ENV=development

# Signs session cookies. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 24 characters. Never reuse the value between environments.
SESSION_SECRET="replace-me-with-a-generated-secret"

# Comma-separated origins allowed to call the API with credentials.
WEB_ORIGIN="http://localhost:5173"

UPLOAD_DIR="./uploads"

# Register/login attempts allowed per IP per 5 minutes. Raised in test runs.
AUTH_RATE_LIMIT_MAX=30

# TRUST_PROXY=1 # optional: hop count or CIDR list when behind a reverse proxy

# --- Mail --------------------------------------------------------------
# With MAIL_ENABLED=false nothing is sent and sign-up skips address
# confirmation. That is how development runs, and it is also the escape hatch
# if SMTP breaks: signing in stops depending on mail delivery.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="FlowDesk <no-reply@example.com>"
EMAIL_TOKEN_TTL_HOURS=48

# Version of the personal-data policy. Bump it together with the text on
# /privacy: consent to one wording is not consent to the next.
PRIVACY_POLICY_VERSION=2026-09-12
