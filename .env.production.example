# Copy to .env.production on the server and fill in. Never commit the result.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# The domain Caddy obtains a certificate for. Its A record must already point
# at this host, and ports 80 and 443 must be reachable from the internet.
DOMAIN=analysium.space

# Where Let's Encrypt sends expiry warnings.
ADMIN_EMAIL=you@example.com

# Database. The container is not published to the host, so this password only
# guards the compose network — but generate a real one anyway.
POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=
POSTGRES_DB=flowdesk

# Signs session cookies. Generate once, keep it stable — changing it signs
# everyone out:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Leave open for the first run so you can create the first account and
# workspace. Set to false once the team is in: members keep inviting each
# other, and the public sign-up form closes.
ALLOW_PUBLIC_REGISTRATION=true

# warn keeps the log to real problems; the proxy already records requests.
LOG_LEVEL=warn

# Backup cadence and retention. Defaults: once a day, kept for 14 days.
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP_DAYS=14

# --- Mail --------------------------------------------------------------
# Turn on to require e-mail confirmation at sign-up. Any provider will do —
# this is plain SMTP, so Yandex, Brevo, Resend or a company mailbox are all a
# matter of these four values.
#
# Leave it off until the SMTP settings are known to work: with mail on and the
# server unreachable, nobody can finish registering.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="FlowDesk <no-reply@analysium.space>"
EMAIL_TOKEN_TTL_HOURS=48
# Days an invitation link stays open.
INVITE_TOKEN_TTL_DAYS=14

