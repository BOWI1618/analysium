# Copy to .env.production on the server and fill in. Never commit the result.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# The domain Caddy obtains a certificate for. Its A record must already point
# at this host, and ports 80 and 443 must be reachable from the internet.
DOMAIN=analysium.space

# Where Let's Encrypt sends expiry warnings.
ADMIN_EMAIL=you@example.com

# Database. The container is not published to the host, so this password only
# guards the compose network — but generate a real one anyway.
POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=
POSTGRES_DB=flowdesk

# Signs session cookies. Generate once, keep it stable — changing it signs
# everyone out:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# There is no switch for sign-up: the form works only until the first account
# exists — that account owns the workspace — and after that people get in by
# the links its owner makes (workspace settings → members).

# warn keeps the log to real problems; the proxy already records requests.
LOG_LEVEL=warn

# Backup cadence and retention. Defaults: once a day, kept for 14 days.
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP_DAYS=14

# --- Access links ------------------------------------------------------
# Days an access link stays open.
INVITE_TOKEN_TTL_DAYS=14

# --- Telegram ------------------------------------------------------------
# Token of the bot from @BotFather (/newbot). With it set, people connect
# Telegram in their account settings and get notifications there at once.
# Empty turns the feature off. This bot must not be used anywhere else: one
# bot is listened to by one server. DEPLOY.md, section 9.
TELEGRAM_BOT_TOKEN=

